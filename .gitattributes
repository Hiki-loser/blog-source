# Normalize all text files to LF in the repository AND in the working tree.
#
# Why eol=lf and not just `text=auto`: this repo is edited on Windows
# (core.autocrlf=true) but built on Linux in CI. Without an explicit eol,
# a Windows checkout gets CRLF in the working tree while the index holds LF,
# which makes `git diff` noisy and would cause the "generated CSS is stale"
# CI guard to fail on line-ending churn rather than on real staleness.
#
# Verify with: git ls-files --eol   (every tracked file should report w/lf)

* text=auto eol=lf

# Binary formats — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.avif binary

# Fonts are binary, despite sometimes being misdetected as text.
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary

# SVG is text and benefits from readable diffs.
*.svg text eol=lf
