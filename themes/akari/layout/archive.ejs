<%#
  Archive listing. Rendered inside the <main> of layout.ejs.
%>
<%
const akari = akari_config();
const archiveText = akari.ui?.archive || {};
const locale = akari.site?.language || config.language || 'zh-CN';
%>

<div class="mb-8">
  <h1 class="text-3xl font-bold mb-2 bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent"><%= archiveText.title || '文章归档' %></h1>
  <p class="text-gray-600 dark:text-gray-400"><%= archiveText.subtitle || '记录每一刻的思考与成长' %></p>
</div>

<%#
  Newest first, as before. The tie-break on path keeps the order total: posts
  sharing a date would otherwise be listed in whatever sequence the parallel
  file reads completed, which is not stable across builds.
%>
<%
const archivePosts = (site.posts && typeof site.posts.toArray === 'function' ? site.posts.toArray() : []);
archivePosts.sort(function (a, b) {
  const byDate = new Date(b.date) - new Date(a.date);
  if (byDate !== 0) return byDate;
  const pathA = String(a.path || '');
  const pathB = String(b.path || '');
  return pathA < pathB ? -1 : (pathA > pathB ? 1 : 0);
});
%>

<div class="space-y-8">
  <% archivePosts.forEach(function(post) { %>
    <div class="relative pl-16 group">
      <div class="absolute left-[13px] top-3 w-3 h-3 rounded-full bg-gradient-to-r from-primary-500 to-secondary-500 border-4 border-white dark:border-gray-800 shadow-lg group-hover:scale-125 transition-transform duration-200"></div>
      <a href="<%- url_for(post.path) %>" class="block p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-lg hover:shadow-primary-500/10 transition-all duration-200">
        <div class="flex items-center justify-between gap-4">
          <div class="flex-1 min-w-0">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors truncate"><%= post.title %></h3>
            <% if (post.excerpt) { %><p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-1"><%- post.excerpt.replace(/<[^>]*>/g, '') %></p><% } %>
          </div>
          <time class="flex-shrink-0 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap"><%= new Date(post.date).toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' }) %></time>
        </div>
      </a>
    </div>
  <% }); %>
</div>
