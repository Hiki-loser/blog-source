<%
const akari = akari_config();
const siteTitle = akari.site?.title || config.title || 'Hexo';
const archiveText = akari.ui?.archive || {};
const locale = akari.site?.language || config.language || 'zh-CN';
%>

<!DOCTYPE html>
<html lang="<%- typeof language !== 'undefined' ? language : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title><%= archiveText.page_title || '归档' %> | <%= siteTitle %></title>
  <link rel="icon" type="image/svg+xml" href="<%- url_for('/img/favicon.svg') %>">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            primary: { 50: '#fef7ff', 100: '#faeeff', 200: '#f5dfff', 300: '#edc6ff', 400: '#e2a2ff', 500: '#d675ff', 600: '#c146ff', 700: '#a828f9', 800: '#8d1fd0', 900: '#751eaa', 950: '#4f0d7a' },
            secondary: { 50: '#f5f3ff', 100: '#ede9fe', 200: '#ddd6fe', 300: '#c4b5fd', 400: '#a78bfa', 500: '#8b5cf6', 600: '#7c3aed', 700: '#6d28d9', 800: '#5b21b6', 900: '#4c1d95' },
            accent: { 50: '#fdf4ff', 100: '#fae8ff', 200: '#f5d0fe', 300: '#f0abfc', 400: '#e879f9', 500: '#d946ef', 600: '#c026d3', 700: '#a21caf', 800: '#86198f', 900: '#701a75' }
          },
          fontFamily: { sans: ['-apple-system', 'BlinkMacSystemFont', 'Helvetica Neue', 'Helvetica', 'Arial', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'sans-serif'] }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-300" style="--background-image-api: url('<%= akari.home?.background_image?.api || 'https://uapis.cn/api/v1/random/image?category=landscape' %>');">

<div class="min-h-screen">
  <%- partial('partial/header') %>

  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="mb-8">
      <h1 class="text-3xl font-bold mb-2 bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent"><%= archiveText.title || '文章归档' %></h1>
      <p class="text-gray-600 dark:text-gray-400"><%= archiveText.subtitle || '记录每一刻的思考与成长' %></p>
    </div>

    <div class="space-y-8">
      <% site.posts.sort('-date').forEach(function(post) { %>
        <div class="relative pl-16 group">
          <div class="absolute left-[13px] top-3 w-3 h-3 rounded-full bg-gradient-to-r from-primary-500 to-secondary-500 border-4 border-white dark:border-gray-800 shadow-lg group-hover:scale-125 transition-transform duration-200"></div>
          <a href="<%- url_for(post.path) %>" class="block p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-lg hover:shadow-primary-500/10 transition-all duration-200">
            <div class="flex items-center justify-between gap-4">
              <div class="flex-1 min-w-0">
                <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors truncate"><%= post.title %></h3>
                <% if (post.excerpt) { %><p class="text-sm text-gray-500 dark:text-gray-400 mt-1 line-clamp-1"><%- post.excerpt.replace(/<[^>]*>/g, '') %></p><% } %>
              </div>
              <time class="flex-shrink-0 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap"><%= new Date(post.date).toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' }) %></time>
            </div>
          </a>
        </div>
      <% }); %>
    </div>
  </main>

  <%- partial('partial/footer') %>
</div>

<script src="<%- url_for('/js/dark-mode.js') %>"></script>
</body>
</html>
