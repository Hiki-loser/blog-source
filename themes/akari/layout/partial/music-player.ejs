<%
const akari = akari_config();
const musicConfig = akari.music || {};
if (!musicConfig.enable) return;
%>

<div class="music-player-container no-print">
  <% if (musicConfig.type === 'netease') { %>
    <!-- 网易云音乐 -->
    <div class="fixed bottom-4 right-4 z-40 transform translate-y-2 opacity-0 transition-all duration-300" id="music-toggle">
      <button
        onclick="toggleMusicPlayer()"
        class="p-3 rounded-full bg-gradient-to-r from-primary-500 to-secondary-500 text-white shadow-lg hover:shadow-xl hover:scale-110 transition-all"
        aria-label="Toggle music player"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
        </svg>
      </button>
    </div>

    <iframe
      frameborder="no"
      border="0"
      marginwidth="0"
      marginheight="0"
      width="330"
      height="86"
      src="https://music.163.com/outchain/player?type=2&id=<%= musicConfig.playlist_id %>&auto=<%= musicConfig.auto ? 1 : 0 %>&height=66"
      class="fixed bottom-20 right-4 z-40 rounded-xl shadow-2xl hidden"
      id="netease-player"
    ></iframe>
  <% } else if (musicConfig.type === 'spotify') { %>
    <!-- Spotify -->
    <iframe
      style="border-radius:12px"
      src="https://open.spotify.com/embed/playlist/<%= musicConfig.playlist_id %>?utm_source=generator&theme=0"
      width="100%"
      height="152"
      frameBorder="0"
      allowfullscreen=""
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
      class="rounded-2xl shadow-lg"
    ></iframe>
  <% } else if (musicConfig.type === 'custom') { %>
    <!-- Custom Player -->
    <div class="custom-music-player">
      <%- musicConfig.custom_html %>
    </div>
  <% } %>
</div>

<% if (musicConfig.type === 'netease') { %>
<script>
  function toggleMusicPlayer() {
    const player = document.getElementById('netease-player');
    const toggleBtn = document.getElementById('music-toggle');

    if (!player || !toggleBtn) {
      return;
    }

    if (player.classList.contains('hidden')) {
      player.classList.remove('hidden');
      player.classList.add('animate-scale-in');
      toggleBtn?.classList.add('active');
    } else {
      player.classList.add('hidden');
      toggleBtn?.classList.remove('active');
    }
  }

  // Show toggle button on scroll
  window.addEventListener('scroll', function() {
    const toggleBtn = document.getElementById('music-toggle');

    if (!toggleBtn) {
      return;
    }

    if (window.scrollY > 300) {
      toggleBtn?.classList.remove('translate-y-2', 'opacity-0');
    } else {
      toggleBtn?.classList.add('translate-y-2', 'opacity-0');
    }
  });
</script>
<% } %>

<style>
  .music-player-container {
    /* Container styles */
  }

  .fixed {
    position: fixed;
  }

  .bottom-4 {
    bottom: 1rem;
  }

  .right-4 {
    right: 1rem;
  }

  .z-40 {
    z-index: 40;
  }

  @keyframes scaleIn {
    from {
      transform: scale(0.9);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .animate-scale-in {
    animation: scaleIn 0.3s ease-out;
  }
</style>
