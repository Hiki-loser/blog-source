<%
const akari = akari_config();
const sidebarText = akari.ui?.sidebar || {};
const categories = site.categories || [];
const hasCategories = categories && categories.length > 0;
const categoriesData = akari.categories || {};

const iconMap = {
  code: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>',
  heart: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>',
  star: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>',
  folder: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>'
};

function findMetaByKey(key) {
  if (categoriesData[key]) {
    return categoriesData[key];
  }

  const parentKeys = Object.keys(categoriesData || {});
  for (let i = 0; i < parentKeys.length; i += 1) {
    const parent = categoriesData[parentKeys[i]] || {};
    const sub = (parent.subcategories && parent.subcategories[key]) || null;
    if (sub) {
      return { ...parent, ...sub };
    }
  }

  return {};
}

function getIcon(iconName) {
  return iconMap[iconName] || iconMap.folder;
}
%>

<% if (hasCategories) { %>
<div class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border border-gray-100 dark:border-gray-700 p-5 animate-fade-in" data-category>
  <h3 class="text-sm font-bold text-gray-900 dark:text-white mb-4 flex items-center gap-2">
    <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
    </svg>
    <%= sidebarText.categories_title || '分类' %>
  </h3>

  <div class="flex flex-wrap gap-2">
    <% categories.forEach(function(category) { %>
      <% const meta = findMetaByKey(category.name); %>
      <a
        href="<%- url_for(category.path) %>"
        class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-sm font-medium bg-gradient-to-r from-primary-100 to-primary-50 dark:from-primary-900/30 dark:to-primary-800/20 text-primary-700 dark:text-primary-400 hover:from-primary-500 hover:to-primary-600 hover:text-white transition-all duration-200 transform hover:scale-105 shadow-sm hover:shadow-md"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <%- getIcon(meta.icon) %>
        </svg>
        <span><%= meta.name || category.name %></span>
        <span class="ml-0.5 px-1.5 py-0.5 text-xs rounded-full bg-white/50 dark:bg-gray-900/30">
          <%= category.length %>
        </span>
      </a>
    <% }); %>
  </div>
</div>
<% } %>
