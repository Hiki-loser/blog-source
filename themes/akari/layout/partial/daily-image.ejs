<%
const akari = akari_config();
const dailyImage = akari.home?.daily_image || {};
const dailyImageApi = dailyImage.api || 'https://uapis.cn/api/v1/random/image?category=acg&type=pc';
const refreshSeparator = dailyImageApi.includes('?') ? '&' : '?';
const altText = dailyImage.alt_text || '每日 ACG 美图';
const refreshEnabled = dailyImage.refresh !== false;
const imageId = 'daily-image-photo';
const refreshButtonId = 'daily-image-refresh';
const downloadButtonId = 'daily-image-download';
const modalId = 'daily-image-modal';
const modalImageId = 'daily-image-modal-photo';
const closeButtonId = 'daily-image-close';
const uiActions = akari.ui?.actions || {};
const dailyImageUi = akari.ui?.daily_image || {};
const fallbackText = dailyImageUi.fallback_text || 'ACG Daily Image';
const fallbackSvg = 'data:image/svg+xml,' + encodeURIComponent(
  '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 840 360">' +
  '<rect fill="#d675ff" width="840" height="360"/>' +
  '<text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" font-family="sans-serif" font-size="24" fill="white">' + fallbackText + '</text>' +
  '</svg>'
);
%>

<div class="relative overflow-hidden rounded-2xl shadow-xl group animate-fade-in">
  <!-- Image Container -->
  <div class="aspect-[21/9] w-full bg-gradient-to-br from-primary-100 via-secondary-100 to-accent-100 dark:from-primary-900/30 dark:via-secondary-900/30 dark:to-accent-900/30">
    <img
      id="<%= imageId %>"
      src="<%= dailyImageApi %>"
      alt="<%= altText %>"
      class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out opacity-0 cursor-zoom-in"
      loading="lazy"
      decoding="async"
      onload="this.style.opacity='1'"
      onerror="this.dataset.fallbackApplied='true';this.src='<%= fallbackSvg %>'"
    />
  </div>

  <!-- Overlay Gradient -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

  <!-- Info Badge -->
  <div class="absolute bottom-4 left-4 flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm shadow-lg transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
    <svg class="w-4 h-4 text-primary-500" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
    </svg>
    <span class="text-sm font-medium text-gray-700 dark:text-gray-300"><%= altText %></span>
  </div>

  <!-- Refresh Button (Optional API support) -->
  <% if (refreshEnabled) { %>
    <button
      type="button"
      id="<%= refreshButtonId %>"
      class="absolute top-4 right-4 p-2 rounded-full bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm shadow-lg opacity-0 group-hover:opacity-100 transform translate-y-2 group-hover:translate-y-0 transition-all duration-300 hover:bg-primary-500 hover:text-white"
      aria-label="<%= uiActions.refresh_image || '刷新图片' %>"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
      </svg>
    </button>
  <% } %>

  <!-- Hover Glow Effect -->
  <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-primary-500/20 to-secondary-500/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
</div>

<!-- Fullscreen Viewer -->
<div
  id="<%= modalId %>"
  class="fixed inset-0 z-[9999] hidden items-center justify-center bg-black/95 p-4"
  role="dialog"
  aria-modal="true"
  aria-label="<%= altText %>"
>
  <button
    type="button"
    id="<%= closeButtonId %>"
    class="absolute top-4 right-4 rounded-full bg-white/15 hover:bg-white/25 text-white p-2 transition-colors"
    aria-label="<%= uiActions.close || '关闭' %>"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <a
    id="<%= downloadButtonId %>"
    href="<%= dailyImageApi %>"
    download="acg-daily-image.jpg"
    class="absolute top-4 right-16 rounded-full bg-white/15 hover:bg-white/25 text-white p-2 transition-colors"
    aria-label="<%= uiActions.download_image || '下载图片' %>"
  >
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v10m0 0l-4-4m4 4l4-4M4 20h16"></path>
    </svg>
  </a>

  <img
    id="<%= modalImageId %>"
    alt="<%= altText %>"
    class="max-h-[92vh] max-w-[95vw] object-contain"
  />
</div>

<script>
  (function () {
    const imageApi = <%- JSON.stringify(dailyImageApi) %>
    const refreshSeparator = <%- JSON.stringify(refreshSeparator) %>
    const fallbackSvg = <%- JSON.stringify(fallbackSvg) %>
    const imageLoadTimeout = <%= dailyImage.timeout || 8000 %>
    const imageSkipOnSaveData = <%= dailyImage.skip_on_save_data !== false %>
    const imageEl = document.getElementById('<%= imageId %>')
    const refreshEl = document.getElementById('<%= refreshButtonId %>')
    const modalEl = document.getElementById('<%= modalId %>')
    const modalImageEl = document.getElementById('<%= modalImageId %>')
    const closeEl = document.getElementById('<%= closeButtonId %>')
    const downloadEl = document.getElementById('<%= downloadButtonId %>')

    if (!imageEl || !modalEl || !modalImageEl || !closeEl || !downloadEl) {
      return
    }

    const syncImageSource = () => {
      const currentUrl = imageEl.currentSrc || imageEl.src
      if (currentUrl) {
        modalImageEl.src = currentUrl
        downloadEl.href = currentUrl
      }
    }

    /*
     * The download link points straight at the resolved image URL.
     *
     * This used to `fetch(targetUrl, { cache: 'force-cache' })` and convert the
     * result to an object URL. That fetch could never succeed — the API's
     * redirect target sends no Access-Control-Allow-Origin, so the request was
     * always blocked and the catch branch did exactly what this does now.
     * Removing it drops a guaranteed-failing cross-origin request per image
     * load with no behaviour change.
     *
     * (Browsers ignore the `download` attribute on cross-origin URLs anyway, so
     * the link opens rather than saves. Making it truly save would need a CORS
     * header this host does not send.)
     */
    const updateDownloadLink = () => {
      const targetUrl = imageEl.currentSrc || imageEl.src
      if (targetUrl) {
        downloadEl.href = targetUrl
      }
    }

    const closeModal = () => {
      modalEl.classList.add('hidden')
      modalEl.classList.remove('flex')
      document.body.style.overflow = ''
    }

    const openModal = () => {
      syncImageSource()
      modalEl.classList.remove('hidden')
      modalEl.classList.add('flex')
      document.body.style.overflow = 'hidden'
      updateDownloadLink()
    }

    imageEl.addEventListener('load', () => {
      syncImageSource()
      updateDownloadLink()
    })

    imageEl.addEventListener('error', () => {
      modalImageEl.src = fallbackSvg
      downloadEl.href = fallbackSvg
    })

    imageEl.addEventListener('click', (event) => {
      event.preventDefault()
      openModal()
    })

    /*
     * Load through AkariApiImage so the request is time-bounded. The element
     * already carries the API URL as its src, so the hero still appears without
     * JS; this runs immediately after it in document order.
     *
     * There is no cache to prime here — this API's image genuinely cannot be
     * reused (see the header of js/api-image.js). What this buys is the timeout
     * and the data-saver skip.
     */
    if (window.AkariApiImage) {
      window.AkariApiImage.attach(imageEl, imageApi, {
        timeout: imageLoadTimeout,
        skipOnSaveData: imageSkipOnSaveData
      }).then((result) => {
        // null means the wait timed out, the load failed, or the connection is
        // metered. Show the placeholder rather than leaving the frame at
        // opacity 0 forever, which is what a plain hang used to do.
        if (!result) {
          imageEl.dataset.fallbackApplied = 'true'
          imageEl.src = fallbackSvg
        }
      }).catch(() => { /* an image failure is never the reader's problem */ })
    }

    if (refreshEl) {
      refreshEl.addEventListener('click', (event) => {
        event.preventDefault()
        // The API ignores caching anyway, but the cache-busting parameters make
        // the intent explicit and sidestep any intermediary cache.
        const nextSrc = imageApi + refreshSeparator + 't=' + Date.now() + '&r=' + Math.random().toString(36).slice(2)
        imageEl.style.opacity = '0'
        imageEl.src = nextSrc
      })
    }

    closeEl.addEventListener('click', closeModal)

    modalEl.addEventListener('click', (event) => {
      if (event.target === modalEl) {
        closeModal()
      }
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modalEl.classList.contains('hidden')) {
        closeModal()
      }
    })

    syncImageSource()
  })()
</script>
