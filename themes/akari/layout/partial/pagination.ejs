<%
const akari = akari_config();
const paginationText = akari.ui?.pagination || {};

/*
 * Windowed page list.
 *
 * This used to render EVERY page number — `for (i = 1; i <= paginator.total)` —
 * so the control grew linearly with the archive and would have become a wall of
 * a hundred buttons. Now it shows the first page, the last page, and a couple of
 * neighbours of the current one, with a gap marker between runs.
 *
 * It also fixes two accessibility gaps: the <nav> had no label (there are
 * several navs on a page) and the current page was a <span> with no
 * aria-current, so it was announced as ordinary text rather than as the page you
 * are on.
 */
const WINDOW = 2;

function pageUrl(index) {
  return index === 1 ? '/' : String(paginator.path).replace('%d', index);
}

const items = [];
let lastShown = 0;

for (let i = 1; i <= paginator.total; i++) {
  const keep = i === 1 || i === paginator.total || Math.abs(i - paginator.current) <= WINDOW;
  if (!keep) continue;
  if (lastShown && i - lastShown > 1) items.push('gap');
  items.push(i);
  lastShown = i;
}
%>

<% if (paginator && paginator.total > 1) { %>
<nav class="flex flex-wrap items-center justify-center gap-2 mt-8 animate-fade-in" aria-label="<%= paginationText.label || '分页导航' %>">
  <% if (paginator.prev) { %>
    <a
      href="<%- url_for(paginator.prev) %>"
      rel="prev"
      class="flex items-center gap-1 px-4 py-2 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-600 dark:hover:text-primary-400 hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-200 font-medium"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      <%= paginationText.prev || '上一页' %>
    </a>
  <% } %>

  <% items.forEach(function (item) { %>
    <% if (item === 'gap') { %>
      <span class="px-2 py-2 text-gray-400" aria-hidden="true">…</span>
    <% } else if (item === paginator.current) { %>
      <span
        aria-current="page"
        class="px-4 py-2 rounded-xl bg-gradient-to-r from-primary-500 to-secondary-500 text-white font-bold shadow-lg shadow-primary-500/25"
      ><%= item %></span>
    <% } else { %>
      <a
        href="<%- url_for(pageUrl(item)) %>"
        class="px-4 py-2 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-600 dark:hover:text-primary-400 hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-200 font-medium"
        aria-label="第 <%= item %> 页"
      ><%= item %></a>
    <% } %>
  <% }); %>

  <% if (paginator.next) { %>
    <a
      href="<%- url_for(paginator.next) %>"
      rel="next"
      class="flex items-center gap-1 px-4 py-2 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-600 dark:hover:text-primary-400 hover:border-primary-300 dark:hover:border-primary-700 transition-all duration-200 font-medium"
    >
      <%= paginationText.next || '下一页' %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  <% } %>
</nav>
<% } %>
