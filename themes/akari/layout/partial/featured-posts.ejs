<%
const akari = akari_config();
const homeText = akari.ui?.home || {};
function toPostArray(collection) {
  if (!collection) return [];
  if (Array.isArray(collection)) return collection.slice();
  if (typeof collection.toArray === 'function') return collection.toArray();

  const arr = [];
  if (typeof collection.forEach === 'function') {
    collection.forEach(function (item) {
      arr.push(item);
    });
  }
  return arr;
}

const allPosts = typeof page.posts !== 'undefined' && page.posts
  ? toPostArray(page.posts)
  : (typeof posts !== 'undefined' && posts ? toPostArray(posts) : toPostArray(site.posts));
const introPosts = allPosts.filter(function (post) {
  return akari_is_intro_post(post);
});
const showIntroOnly = (akari.home && akari.home.intro_only) !== false;
const displayPosts = showIntroOnly ? introPosts : allPosts;
const postsToRender = displayPosts.length > 0 ? displayPosts : allPosts;
const statsLabels = homeText.stats || {};
%>

<section class="space-y-4">
  <!-- Section Header -->
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-bold flex items-center gap-2">
      <span class="w-1 h-8 bg-gradient-to-b from-primary-500 to-secondary-500 rounded-full"></span>
      <span class="bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent"><%= homeText.latest_posts_title || '最新文章' %></span>
    </h2>
    <a href="<%- url_for('/archives') %>" class="text-sm text-gray-500 dark:text-gray-400 hover:text-primary-500 dark:hover:text-primary-400 transition-colors flex items-center gap-1">
      <%= homeText.view_more || '查看更多' %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </a>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
    <div class="rounded-xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400"><%= statsLabels.posts || '总文章' %></p>
      <p class="text-xl font-bold text-primary-600 dark:text-primary-400"><%= site.posts.length %></p>
    </div>
    <div class="rounded-xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400"><%= statsLabels.intro_posts || '分类封面' %></p>
      <p class="text-xl font-bold text-primary-600 dark:text-primary-400"><%= introPosts.length %></p>
    </div>
    <div class="rounded-xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400"><%= statsLabels.categories || '分类数' %></p>
      <p class="text-xl font-bold text-primary-600 dark:text-primary-400"><%= site.categories.length %></p>
    </div>
    <div class="rounded-xl bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 p-3">
      <p class="text-xs text-gray-500 dark:text-gray-400"><%= statsLabels.tags || '标签数' %></p>
      <p class="text-xl font-bold text-primary-600 dark:text-primary-400"><%= site.tags.length %></p>
    </div>
  </div>

  <!-- Posts List -->
  <div class="space-y-4">
    <% if (postsToRender.length > 0) { %>
      <% postsToRender.forEach(function(post) { %>
        <%- partial('partial/post-card', { post: post }) %>
      <% }); %>
    <% } else { %>
      <div class="rounded-2xl border border-dashed border-gray-300 dark:border-gray-600 p-8 text-center text-gray-600 dark:text-gray-300 bg-white/70 dark:bg-gray-800/70">
        <%= homeText.empty_posts || '暂无文章，开始创作吧。' %>
      </div>
    <% } %>
  </div>

  <!-- Pagination -->
  <% if (typeof paginator !== 'undefined' && paginator) { %>
    <%- partial('partial/pagination') %>
  <% } %>
</section>
