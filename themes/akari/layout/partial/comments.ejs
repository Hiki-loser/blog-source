<%
const akari = akari_config();
const commentConfig = akari.comment || {};
const commentType = commentConfig.type || 'giscus';
const commentEnabled = commentConfig.enable;
const commentText = akari.ui?.comments || {};
const locale = akari.site?.language || config.language || 'zh-CN';
%>

<% if (!commentEnabled) { return; } %>

<div id="comments" class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700 p-6 sm:p-8">
  <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
    <svg class="w-6 h-6 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
    </svg>
    <%= commentText.title || '评论' %>
  </h2>

  <% if (commentType === 'giscus') { %>
    <!-- Giscus Comments -->
    <div id="giscus-comments"></div>
  <% } else if (commentType === 'valine') { %>
    <!-- Valine Comments -->
    <div id="vcomments"></div>
  <% } else if (commentType === 'utterances') { %>
    <!-- Utterances Comments -->
    <div class="utterances-container"></div>
  <% } %>
</div>

<% if (commentType === 'giscus' && commentConfig.giscus) { %>
<script src="https://giscus.app/client.js"
  data-repo="<%= commentConfig.giscus.repo %>"
  data-repo-id="<%= commentConfig.giscus.repo_id %>"
  data-category="<%= commentConfig.giscus.category %>"
  data-category-id="<%= commentConfig.giscus.category_id %>"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="bottom"
  data-theme="preferred_color_scheme"
  data-lang="<%= locale %>"
  data-loading="lazy"
  crossorigin="anonymous"
  async>
</script>
<% } %>

<% if (commentType === 'valine' && commentConfig.valine) { %>
<script src="https://cdn.jsdelivr.net/npm/valine@1.5.1/dist/Valine.min.js"></script>
<script>
  new Valine({
    el: '#vcomments',
    appId: '<%= commentConfig.valine.appId %>',
    appKey: '<%= commentConfig.valine.appKey %>',
    placeholder: '<%= commentText.valine_placeholder || '留下你的评论吧～' %>',
    avatar: 'mp',
    lang: '<%= locale %>',
    visitor: true,
    recordIP: true,
    pageSize: 10,
    highlight: true
  });
</script>
<% } %>

<% if (commentType === 'utterances' && commentConfig.utterances) { %>
<script src="https://utteranc.es/client.js"
  repo="<%= commentConfig.utterances.repo %>"
  issue-term="pathname"
  theme="preferred-color-scheme"
  label="<%= commentText.utterances_label || '💬 评论' %>"
  crossorigin="anonymous"
  async>
</script>
<% } %>

<% if ((commentType === 'giscus' && !commentConfig.giscus?.repo) || (commentType === 'valine' && (!commentConfig.valine?.appId || !commentConfig.valine?.appKey)) || (commentType === 'utterances' && !commentConfig.utterances?.repo)) { %>
  <p class="mt-4 text-sm text-gray-500 dark:text-gray-400"><%= commentText.incomplete_hint || '评论功能已开启，但配置尚不完整，请补全 _config.yml 中 akari.comment 配置。' %></p>
<% } %>
