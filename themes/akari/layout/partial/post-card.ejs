<%
const akari = akari_config();
const locale = akari.site?.language || config.language || 'zh-CN';
const p = typeof post !== 'undefined' ? post : (typeof page !== 'undefined' ? page : null);
if (!p) return;
const postUrl = p.permalink || url_for(p.path);
const coverImage = p.cover || p.thumbnail || '';
// Sorted, not raw: a post's categories/tags have no stable order across builds
// (see akari_sort_terms in scripts/akari-config.js). Which one lands in
// categories[0] below was previously random from build to build.
const categories = akari_sort_terms(p.categories, 'name');
const tags = akari_sort_terms(p.tags, 'name');
%>

<article class="group bg-white dark:bg-gray-800 rounded-2xl shadow-sm hover:shadow-xl hover:shadow-primary-500/10 transition-all duration-300 overflow-hidden border border-gray-100 dark:border-gray-700">
  <div class="flex flex-col sm:flex-row gap-0 sm:gap-4 p-4 sm:p-5">
    <% if (coverImage) { %>
      <div class="sm:w-48 h-40 sm:h-32 flex-shrink-0 overflow-hidden rounded-xl">
        <%# alt="" because the card's own heading already announces the title —
            a non-empty alt here made screen readers read it twice per card, on
            every listing page. Lazy is correct for a card: these are below the
            fold and there is one per post per page. %>
        <img src="<%= coverImage %>" alt="" loading="lazy" decoding="async" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500" />
      </div>
    <% } %>

    <div class="flex-1 min-w-0 space-y-3">
      <a href="<%= postUrl %>" class="block group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
        <h3 class="text-lg font-bold line-clamp-2 group-hover:translate-x-1 transition-transform duration-200"><%= p.title %></h3>
      </a>

      <p class="text-gray-600 dark:text-gray-400 text-sm line-clamp-2 leading-relaxed">
        <% if (p.excerpt) { %>
          <%- p.excerpt.replace(/<[^>]*>/g, '') %>
        <% } else if (p.description) { %>
          <%= p.description %>
        <% } else if (p.content) { %>
          <%= p.content.replace(/<[^>]*>/g, '').substring(0, 150) %>...
        <% } %>
      </p>

      <div class="flex items-center justify-between pt-2">
        <div class="flex items-center gap-2 flex-wrap">
          <% if (categories.length > 0) { %>
            <%# The leaf segment, via the shared resolver: category.name is the
                FULL path, so rendering it raw showed "technology/python" next to
                a sidebar that says "Python". %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-400"><%= akari_category_meta(categories[0].name).leafName %></span>
          <% } %>
          <% if (tags.length > 0) { %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-secondary-100 dark:bg-secondary-900/30 text-secondary-700 dark:text-secondary-400"><%= tags[0].name %></span>
          <% } %>
        </div>

        <time class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <%= new Date(p.date).toLocaleDateString(locale, { year: 'numeric', month: 'short', day: 'numeric' }) %>
        </time>
      </div>
    </div>
  </div>
</article>
