<%#
  Home / paginated index. Rendered inside the <main> of layout.ejs, which also
  supplies the page shell, header, footer and scripts.
%>
<%
const akari = akari_config();
%>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <!-- Left Main Area -->
  <div class="lg:col-span-2 space-y-8">
    <!-- Daily Image / Hero Section -->
    <% if (akari.home?.daily_image?.enable) { %>
      <%- partial('partial/daily-image') %>
    <% } %>

    <!-- Featured Posts -->
    <%- partial('partial/featured-posts') %>
  </div>

  <!-- Right Sidebar -->
  <div class="space-y-6">
    <!-- Profile Card -->
    <%- partial('partial/profile-card') %>

    <!-- Social Links -->
    <%- partial('partial/social-links') %>

    <!-- Categories -->
    <%- partial('partial/categories') %>

    <!-- Tags -->
    <%- partial('partial/tags') %>
  </div>
</div>
