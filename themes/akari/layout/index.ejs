<%
const akari = akari_config();
const siteTitle = akari.site?.title || config.title || 'Hexo';
const siteDescription = akari.site?.description || config.description || '';
const siteKeywords = Array.isArray(akari.site?.keywords) ? akari.site.keywords.join(',') : '';
%>

<!DOCTYPE html>
<html lang="<%- typeof language !== 'undefined' ? language : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="description" content="<%= siteDescription %>">
  <meta name="keywords" content="<%= siteKeywords %>">

  <title><%= siteTitle %></title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="<%- url_for('/img/favicon.svg') %>">

  <!-- TailwindCSS CDN -->
  <%# Tailwind, compiled locally by `npm run build:css` from tailwind.config.js
      and themes/akari/assets/tokens.css. This replaced a render-blocking script
      from the Tailwind CDN, which is unreachable from mainland China and
      compiled CSS in the browser at runtime. Do not reintroduce it. %>
  <link rel="stylesheet" href="<%- url_for('/css/tailwind.css') %>">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-300" style="--background-image-api: url('<%= akari.home?.background_image?.api || 'https://uapis.cn/api/v1/random/image?category=landscape' %>');">

<div class="min-h-screen">
  <!-- Header / Navigation -->
  <%- partial('partial/header') %>

  <!-- Main Content -->
  <main class="container mx-auto px-4 py-8 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Main Area -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Daily Image / Hero Section -->
        <% if (akari.home?.daily_image?.enable) { %>
          <%- partial('partial/daily-image') %>
        <% } %>

        <!-- Featured Posts -->
        <%- partial('partial/featured-posts') %>
      </div>

      <!-- Right Sidebar -->
      <div class="space-y-6">
        <!-- Profile Card -->
        <%- partial('partial/profile-card') %>

        <!-- Social Links -->
        <%- partial('partial/social-links') %>

        <!-- Categories -->
        <%- partial('partial/categories') %>

        <!-- Tags -->
        <%- partial('partial/tags') %>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <%- partial('partial/footer') %>

  <!-- Music Player -->
  <%- partial('partial/music-player') %>
</div>

<!-- Scripts -->
<script src="<%- url_for('/js/dark-mode.js') %>"></script>
</body>
</html>
