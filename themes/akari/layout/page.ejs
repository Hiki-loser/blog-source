<%
const akari = akari_config();
const siteTitle = akari.site?.title || config.title || 'Hexo';
const siteDescription = page.excerpt || page.description || (page.content ? page.content.substring(0, 200).replace(/<[^>]*>/g, '') : '');
const siteKeywords = page.tags ? akari_sort_terms(page.tags, 'name').map(function(t) { return t.name; }).join(',') : (Array.isArray(akari.site?.keywords) ? akari.site.keywords.join(',') : '');
const commentsEnabled = akari.comment?.enable && page.comments !== false;
%>

<!DOCTYPE html>
<html lang="<%- typeof language !== 'undefined' ? language : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="description" content="<%= siteDescription %>">
  <meta name="keywords" content="<%= siteKeywords %>">
  <title><%= page.title %> | <%= siteTitle %></title>
  <link rel="icon" type="image/svg+xml" href="<%- url_for('/img/favicon.svg') %>">
  <%# Tailwind, compiled locally by `npm run build:css` from tailwind.config.js
      and themes/akari/assets/tokens.css. This replaced a render-blocking script
      from the Tailwind CDN, which is unreachable from mainland China and
      compiled CSS in the browser at runtime. Do not reintroduce it. %>
  <link rel="stylesheet" href="<%- url_for('/css/tailwind.css') %>">
  <link rel="stylesheet" href="<%- url_for('/css/style.css') %>">
</head>
<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen transition-colors duration-300" style="--background-image-api: url('<%= akari.home?.background_image?.api || 'https://uapis.cn/api/v1/random/image?category=landscape' %>');">

<div class="min-h-screen">
  <meta name="description" content="<%= siteDescription %>">
  <meta name="keywords" content="<%= siteKeywords %>">
  <%- partial('partial/header') %>

  <main class="container mx-auto px-4 py-8 max-w-4xl">
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-xl overflow-hidden border border-gray-100 dark:border-gray-700">
      <div class="h-48 bg-gradient-to-r from-primary-500 via-secondary-500 to-accent-500 relative">
        <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-30"></div>
      </div>

      <div class="p-8 sm:p-12">
        <h1 class="text-3xl sm:text-4xl font-bold mb-6 bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent"><%= page.title %></h1>

        <div class="prose prose-lg dark:prose-invert max-w-none">
          <%- page.content %>
        </div>

        <% if (commentsEnabled) { %>
          <div class="mt-10"><%- partial('partial/comments') %></div>
        <% } %>
      </div>
    </div>
  </main>

  <%- partial('partial/footer') %>
</div>

<script src="<%- url_for('/js/dark-mode.js') %>"></script>
<script src="<%- url_for('/js/hover-tooltip.js') %>"></script>
</body>
</html>
